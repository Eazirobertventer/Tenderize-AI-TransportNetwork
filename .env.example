# Optional future enrichment keys. Never commit real values.
GOOGLE_MAPS_API_KEY=
DATABASE_URL=postgresql://transport:transport@localhost:5432/transport_network

# TN7 trusted operator authentication. Never commit a real secret.
# The trusted identity issuer signs short-lived HS256 JWTs; the transport API only verifies them.
OPERATOR_JWT_SECRET=
OPERATOR_JWT_ISSUER=tenderize-iam
OPERATOR_JWT_AUDIENCE=transport-network-operator
OPERATOR_JWT_CLOCK_SKEW_SECONDS=30
# TN7-ADJUDICATION-1 kill switch. Keep false outside controlled mutation environments.
OPERATOR_DEFER_ISSUE_ENABLED=false
# TN7-ADJUDICATION-2 kill switches. Keep false outside controlled mutation environments.
OPERATOR_REJECT_ISSUE_ENABLED=false
OPERATOR_REOPEN_ISSUE_ENABLED=false
# TN7-ADJUDICATION-3 dual-control proposal lifecycle. Keep false outside controlled mutation environments.
OPERATOR_DUAL_CONTROL_ENABLED=false
# TN7-ADJUDICATION-4 controlled alias promotion. Requires dual control as well.
OPERATOR_ALIAS_PROMOTION_ENABLED=false
# TN7-ADJUDICATION-5 controlled rank-association relationship promotion.
OPERATOR_ASSOCIATION_ASSIGNMENT_ENABLED=false
